    "## for문 의 기본 구조\n",
    "\n",
    "# for 변수 in 리스트(또는 튜플, 문자열):\n",
    "#     수행할 문장1\n",
    "#     수행할 문장2\n",
    "#     ...\n",
    "\n",
    "\n",
    "lis = [\"one\", \"two\", \"three\"]\n",
    "\n",
    "for li in lis:\n",
    "    print(li)"
